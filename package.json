{
  "name": "steady",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal, auditable playback-rate controller for Firefox and Zen Browser",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.2.7",
    "esbuild": "0.28.2",
    "happy-dom": "20.11.6",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "build:chromium": "node scripts/build.mjs --target=chromium",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "try": "node scripts/try.mjs",
    "bench": "vitest bench --run",
    "perf": "node scripts/perf.mjs",
    "guard": "node scripts/guard.mjs",
    "package": "node scripts/package.mjs",
    "verify": "node scripts/verify.mjs",
    "check": "npm run typecheck && npm run coverage && npm run build && npm run guard",
    "check:all": "npm run check && npm run e2e && npm run verify",
    "deps:report": "node scripts/deps-report.mjs"
  }
}
